#!/usr/bin/expect -f

# Example macOS one-command router login.
# Store the router password in Keychain:
#
# security add-generic-password -U -a root -s LANister-Huawei -w
#
# Then install this script somewhere on your PATH.

set timeout 20
set host "192.168.100.1"
set user "root"
set pass [exec security find-generic-password -a root -s LANister-Huawei -w]

spawn telnet $host

expect -nocase -re {login:[ ]*$}
send -- "$user\r"

expect -nocase -re {password:[ ]*$}
send -- "$pass\r"

expect -re {(^|\r|\n)WAP>[ ]*$}
send -- "su\r"

expect -re {(^|\r|\n)SU_WAP>[ ]*$}
send -- "shell\r"

expect -re {WAP\(Dopra Linux\)[^\r\n]*#[ ]*$}

puts "\nLANister Gate shell ready.\n"
interact
